# ─────────────────────────────────────────────────────────────
# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Google Sign-In  (Google Cloud Console → Clients)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
#
# The consent screen (Data Access) MUST include the scope:
#   https://www.googleapis.com/auth/drive.file
# so the app can create a folder and upload photos into the user's own Drive,
# then read those app-created files back. No API key or Picker needed —
# the browser calls the Drive API directly with the user's access token.
# ─────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
